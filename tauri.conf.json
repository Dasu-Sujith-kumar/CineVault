{
  "productName": "CineVault",
  "version": "0.1.0",
  "identifier": "com.cinevault.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:5173",
    "frontendDist": "../src-tauri/dist"
  },
  "app": {
    "windows": [
      {
        "title": "CineVault",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "msi": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "certificatePath": null,
      "signingKey": null
    },
    "nsis": {
      "artifactId": "cinevault",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutLanguages": [
        1033
      ]
    },
    "linux": {
      "debian": {}
    },
    "windows": {
      "certificatePath": null,
      "digestAlgorithm": "sha256",
      "signingKey": null
    }
  }
}
